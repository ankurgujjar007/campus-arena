PORT=5001
MONGODB_URI=mongodb://localhost:27017
DB_NAME=campusarena
REDIS_URL=redis://localhost:6379
JWT_SECRET=replace-with-a-long-random-secret

# Only needed for the one-time admin bootstrap command.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=use-a-unique-password-of-at-least-12-characters

# Optional password for newly created fictional demo accounts.
# Existing demo passwords are preserved when reseeding.
# DEMO_PASSWORD=choose-a-local-demo-password
